# Hospital Smart Management System (HSMS) Environment Variables
# Copy this file to .env and provide your project credentials.
# If these variables are omitted, the application runs automatically in High-Fidelity Local Demo Mode.

# Firebase Web App Configuration (Client-safe public credentials)
VITE_FIREBASE_API_KEY=your_firebase_api_key_placeholder
VITE_FIREBASE_AUTH_DOMAIN=your-hospital-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-hospital-project
VITE_FIREBASE_STORAGE_BUCKET=your-hospital-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Optional Server-side LLM Integration for Multilingual Screening Summaries
# (Keep private; never expose server keys in client bundle)
VITE_ENABLE_EXTERNAL_AI_API=false
VITE_AI_SERVICE_ENDPOINT=https://your-cloud-functions-url.cloudfunctions.net/triageSummary

# Application Settings
VITE_HOSPITAL_NAME="mWell Health Hospital System"
VITE_DEFAULT_LANGUAGE=en
VITE_EMULATOR_MODE=false
